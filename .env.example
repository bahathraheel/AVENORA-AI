# AVENORA AI — Unified Local Preview / Reference Environment Variables
# For independent deployments:
#   - Backend (Render): use backend/.env.example
#   - Frontend (Netlify): use frontend/.env.example (no secrets)

PORT=3000
NODE_ENV=development
SERVE_FRONTEND=true

# Google Gemini API (strictly backend)
GEMINI_API_KEY=

# Existing Firebase Project (mandatory: avenora-ai)
FIREBASE_PROJECT_ID=avenora-ai
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_DATABASE_ID=
FIREBASE_WEB_API_KEY=

# Google OAuth 2.0 (strictly backend)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Deployed URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3000

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30
AUTH_RATE_LIMIT_MAX=25
