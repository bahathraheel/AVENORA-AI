# AVENORA AI — Unified Local Preview / Reference Environment Variables
# For independent deployments:
#   - Backend (Render): use backend/.env.example
#   - Frontend (Netlify): use frontend/.env.example (no secrets)

PORT=5000
NODE_ENV=production

# Google Gemini API (strictly backend)
GEMINI_API_KEY=

# Existing Firebase Project (mandatory: avenora-ai)
FIREBASE_PROJECT_ID=avenora-ai
FIREBASE_DATABASE_ID=
# Optional keyless WIF JSON path or service account fields (not required when using keyless user-token Firestore mode)
# GOOGLE_APPLICATION_CREDENTIALS=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
FIREBASE_WEB_API_KEY=

# Google OAuth 2.0 (strictly backend)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Deployed URLs
FRONTEND_URL=https://avenoraai3.vercel.app
BACKEND_URL=https://avenora-ai.onrender.com

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30
AUTH_RATE_LIMIT_MAX=25
