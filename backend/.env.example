# Server runtime
PORT=5000
NODE_ENV=production

# Google Gemini API (keep strictly on backend)
GEMINI_API_KEY=

# Existing Firebase project (strictly locked to avenora-ai)
FIREBASE_PROJECT_ID=avenora-ai
# Optional if using a named Firestore database in avenora-ai; leave empty or (default) for default DB
FIREBASE_DATABASE_ID=

# Keyless Cloud Option A (GCP / Workload Identity Federation): path to WIF external_account JSON
# GOOGLE_APPLICATION_CREDENTIALS=

# Optional Service Account credentials (if organization policy allows key creation; not required)
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# Firebase Web API Key for backend Identity Toolkit REST auth verification (never placed in frontend)
FIREBASE_WEB_API_KEY=

# Google OAuth 2.0 credentials for backend Google Sign-In flow (keep secret strictly on backend)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Deployed production URLs for CORS and OAuth callbacks
FRONTEND_URL=https://avenoraai3.vercel.app
BACKEND_URL=https://avenora-ai.onrender.com

# Optional dedicated HMAC/AES secret for sealing short-lived OAuth state tickets
# SESSION_SIGNING_SECRET=

# Rate limiting configuration
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30
AUTH_RATE_LIMIT_MAX=25
