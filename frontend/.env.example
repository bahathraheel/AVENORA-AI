# Centralized Backend API URL (defaults to https://avenora-ai.onrender.com in frontend/config/apiConfig.js)
VITE_API_BASE_URL=https://avenora-ai.onrender.com

# Public Firebase Web App Configuration for existing project: avenora-ai
# Retrieve these values from Firebase Console -> Project Settings -> Your apps (Web app)
# Never put GEMINI_API_KEY, Firebase Admin credentials, or private secrets in frontend/.env
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=avenora-ai.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=avenora-ai
VITE_FIREBASE_STORAGE_BUCKET=avenora-ai.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
